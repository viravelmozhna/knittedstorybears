---
import type { Pattern } from '../lib/patterns';
import Difficulty from './Difficulty.astro';

interface Props {
  pattern: Pattern;
  eager?: boolean;
}
const { pattern, eager = false } = Astro.props;
const { title, description, cover, difficulty } = pattern.data;
const href = `/patterns/${pattern.id}/`;
---

<article class="card">
  <a href={href} class="thumb" tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <img src={cover} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width="600" height="600" />
      ) : (
        <div class="placeholder" />
      )
    }
  </a>
  <div class="body">
    {difficulty && <Difficulty value={difficulty} />}
    <h3><a href={href}>{title}</a></h3>
    {description && <p>{description}</p>}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }
  .card:hover {
    transform: translateY(-3px);
  }
  .card:hover img {
    transform: scale(1.04);
  }
  .thumb {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--surface-2);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .placeholder {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(45deg, var(--surface-2) 0 12px, var(--line) 12px 14px);
  }
  .body {
    padding: 18px 20px 22px;
  }
  h3 {
    font-size: 1.2rem;
    margin: 8px 0 6px;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  /* Whole card is clickable. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  h3 a:focus-visible {
    outline: none;
  }
  .card:has(h3 a:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
  p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
