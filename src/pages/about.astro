---
import BaseLayout from '../layouts/BaseLayout.astro';
import BearFull from '../components/BearFull.astro';
import { SITE } from '../site.config';
---

<BaseLayout title="About" description={`About ${SITE.author} and ${SITE.name}.`}>
  <section class="section">
    <div class="wrap about">
      <div class="portrait">
        <BearFull size={150} />
      </div>
      <div class="prose">
        <p class="eyebrow">About</p>
        <h1>Hi, I'm {SITE.author}</h1>
        <p>
          {SITE.name} is where I share free amigurumi crochet patterns: little animals from the Chinese horoscope, dolls, Easter bunnies and Christmas tree ornaments. Every pattern is written in US crochet terms, with step-by-step photos for the tricky bits.
        </p>
        <h2>Using my patterns</h2>
        <p>
          The patterns here are free for personal use. If you'd like to share one, please link to its page rather than copying the pattern.
        </p>
        <h2>Say hello</h2>
        <p>
          Made something from one of my patterns? I'd love to see it - share it on Instagram with&nbsp;
          <a href="https://www.instagram.com/explore/tags/knittedstorybears/" rel="noopener" target="_blank">#knittedstorybears
          </a>
          &nbsp;or leave a comment under the pattern.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .portrait {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent-soft);
    display: grid;
    place-items: center;
    border: 3px dashed var(--line);
    overflow: hidden;
  }
  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 720px) {
    .about {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 200px;
    }
  }
</style>
