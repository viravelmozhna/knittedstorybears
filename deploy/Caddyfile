# Caddy config for Knitted Story Bears.
# Caddy fetches and renews HTTPS certificates by itself once the domain points here.
# Install: copy these blocks into /etc/caddy/Caddyfile, then  sudo systemctl reload caddy

# Bare domain → www (the address Google already knows from Blogger).
knittedstorybears.com {
	redir https://www.knittedstorybears.com{uri} permanent
}

# The blog: static files built by `npm run build` and uploaded by deploy.sh.
www.knittedstorybears.com {
	root * /var/www/knittedstorybears
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Old Blogger addresses → new pages (uploaded by deploy.sh).
	import /var/www/knittedstorybears-caddy/redirects.caddy

	# Built CSS/JS have content hashes in their names, so they can be cached forever.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@images path /images/*
	header @images Cache-Control "public, max-age=2592000"

	file_server {
		index index.html
		hide .*
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}

	# No "log" directive on purpose: the site's privacy policy says no access
	# logs are kept.
}

# Comments (Remark42, see remark42/docker-compose.yml), running from
# /opt/remark42 with its data in /opt/remark42/var. Remark42 sets its own
# frame/CORS headers for the embed, so none are added here.
comments.knittedstorybears.com {
	# Remark42's admin password (basic auth) is for use on this server only.
	@basic_auth header_regexp Authorization (?i)^\s*basic
	respond @basic_auth 403

	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Remark42's ETag for its widget files doesn't change when the files do
	# (e.g. after relabel.sh rewords them), so browsers kept the old widget.
	# Without it they revalidate by Last-Modified, which follows each rebuild.
	header /web/* -ETag
	# Browsers still holding the stale ETag send it back; drop it so Remark42
	# can't answer 304 to it.
	request_header /web/* -If-None-Match

	# No log, same as the blog: the privacy policy promises no access logs.
}
