# Copy to .env (next to docker-compose.yml) on the server and fill in.
# Keep .env private:  chmod 600 .env
#
# Fastmail: create an app password with SMTP access under
# Settings → Privacy & Security → Manage app passwords. Don't use your
# normal Fastmail password.
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USER=vira@knittedstorybears.com
SMTP_PASS=
# Where messages go, and the sender address (must be an address or alias of
# the SMTP account).
CONTACT_TO=vira@knittedstorybears.com
CONTACT_FROM=vira@knittedstorybears.com
SITE_URL=https://www.knittedstorybears.com
